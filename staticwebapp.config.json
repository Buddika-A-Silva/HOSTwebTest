{
  "navigationFallback": {
    "rewrite": "index.html"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "routes": [
    {
      "route": "*.html",
      "serve": "*.html",
      "statusCode": 200
    },
    {
      "route": "*.json",
      "serve": "*.json",
      "statusCode": 200
    },
    {
      "route": "*.js",
      "serve": "*.js",
      "statusCode": 200
    },
    {
      "route": "*.css",
      "serve": "*.css",
      "statusCode": 200
    },
    {
      "route": "assets/*",
      "serve": "assets/*",
      "statusCode": 200
    },
    {
      "route": "dist/*",
      "serve": "dist/*",
      "statusCode": 200
    }
  ]
}
