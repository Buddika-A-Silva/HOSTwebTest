{
  "navigationFallback": {
    "rewrite": "index.html"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "routes": [
    {
      "route": "/impact.html",
      "redirect": "/mission-impact.html",
      "statusCode": 301
    },
    {
      "route": "/mission.html",
      "redirect": "/mission-impact.html",
      "statusCode": 301
    },
    {
      "route": "/how-we-serve.html",
      "redirect": "/Our%20Services.html",
      "statusCode": 301
    },
    {
      "route": "/Our%20Services.html",
      "serve": "Our Services.html",
      "statusCode": 200
    },
    {
      "route": "*.html",
      "serve": "*.html",
      "statusCode": 200
    },
    {
      "route": "*.json",
      "serve": "*.json",
      "statusCode": 200
    },
    {
      "route": "*.js",
      "serve": "*.js",
      "statusCode": 200
    },
    {
      "route": "*.css",
      "serve": "*.css",
      "statusCode": 200
    },
    {
      "route": "assets/*",
      "serve": "assets/*",
      "statusCode": 200
    },
    {
      "route": "dist/*",
      "serve": "dist/*",
      "statusCode": 200
    }
  ]
}
